// fxContext.ts

import type { Prop, Stream } from "./blooky";

// 型定義
export type FxResolvable = Prop<any> | Stream<any>;

type FxContextMap = Record<string, FxResolvable>;

// 内部保存用（将来のスコープ対応を考慮）
let currentContext: Map<string, FxResolvable> = new Map();

/**
 * PropやStreamを名前で登録する
 */
export function registerFxContext(ctx: FxContextMap): void {
  Object.entries(ctx).forEach(([key, value]) => {
    if (currentContext.has(key)) {
      console.warn(`[fxContext] Overwriting context key: "${key}"`);
    }
    currentContext.set(key, value);
  });
}

/**
 * 個別登録
 */
export function setFxContext(key: string, value: FxResolvable): void {
  if (currentContext.has(key)) {
    console.warn(`[fxContext] Overwriting context key: "${key}"`);
  }
  currentContext.set(key, value);
}

/**
 * 名前で登録解除
 */
export function unregisterFxContext(key: string): void {
  currentContext.delete(key);
}

/**
 * 登録されているPropまたはStreamを取得
 */
export function resolveFxContext(key: string): FxResolvable | undefined {
  return currentContext.get(key);
}

/**
 * 登録をすべて削除
 */
export function clearFxContext(): void {
  currentContext.clear();
}

/**
 * デバッグ用：登録されているキー一覧を取得
 */
export function listFxContext(): string[] {
  return Array.from(currentContext.keys());
}